# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Database (Supabase)
# Supabase ダッシュボード → プロジェクト → Connect → ORM / Prisma タブからコピー。
# 実行時（Vercel/サーバーレス）: トランザクションモードのプーラー (:6543, pgbouncer=true)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# マイグレーション/Prisma CLI: セッションモードの直結 (:5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# JWT (本番ではランダムな長い文字列に)
JWT_SECRET="your-jwt-secret-at-least-32-chars"
JWT_COOKIE_NAME="third_age_session"

# Claude API (Anthropic)
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY="sk-ant-api03-..."

# メール送信（Resend）
# ⚠️ キーは「communitysociety.co.jp がドメイン認証済みのアカウント」のものを使うこと。
#    社内に複数の Resend アカウント／キーが存在する。認証済みなのは
#    third-age-campus が使っているキー（2026-08 時点で communitysociety.co.jp と
#    pic-center.org が verified）。third-age-project の .env.local に入っている
#    ローカル用キーは認証ドメインが0件で、送信すると
#    「The communitysociety.co.jp domain is not verified」で失敗する。
#    確認方法: curl -H "Authorization: Bearer $RESEND_API_KEY" https://api.resend.com/domains
RESEND_API_KEY="re_..."
# 差出人。未設定時は "株式会社COMMUNITY <noreply@communitysociety.co.jp>" が使われる。
FROM_EMAIL="株式会社COMMUNITY <noreply@communitysociety.co.jp>"

# 本番のアプリURL（デプロイ後に設定）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Storage（写真アップロード）＋ Supabase Auth（マジックリンク）
SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Settings → API → service_role key（秘密鍵）
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# ブラウザに出てよい値（Supabase Auth クライアント用）
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-key"

# シード用（初回ユーザー作成。npm run db:seed で admin を作る場合に .env.local に追加）
# SEED_EMAIL="admin@example.com"
# SEED_PASSWORD="your-secure-password"
# SEED_ROLE="admin"
